                { year: 2023, title: 'BEM F. Saintek 2023/2024', desc: 'Anggota Kajian Keilmuan dan Advokasi, melakukan studi isu untuk mengumpulkan dan menganalisis aspirasi dan kekhawatiran mahasiswa, memberikan wawasan untuk upaya advokasi. Berfungsi sebagai sumber informasi beasiswa, membantu mahasiswa mengakses peluang baik di dalam maupun di luar kampus. Membantu mahasiswa yang menghadapi masa percobaan akademik dengan memberikan panduan dan sumber daya untuk peningkatan akademik.', role: 'Anggota Divisi' },
                { year: 2023, title: 'MASFAK 2023', desc: 'Anggota Divisi Acara, berperan dalam perencanaan dan pelaksanaan acara orientasi mahasiswa baru, memastikan kelancaran kegiatan.', role: 'Anggota Divisi' },
                { year: 2023, title: 'Panitia MOTIF 2023', desc: 'Anggota Divisi Konsumsi, memastikan ketersediaan konsumsi yang memadai dan terorganisir selama acara berlangsung.', role: 'Anggota Divisi' },
                { year: 2023, title: 'Panitia HARTIK 2023', desc: 'Anggota Divisi Acara, membantu suksesnya acara tahunan fakultas dengan koordinasi yang baik dan pelaksanaan yang efektif.', role: 'Anggota Divisi' },
                { year: 2023, title: 'SIC (Samsung Innovation Campus) 2023/2024', desc: 'Mengikuti program coding dan programming, mengembangkan kemampuan teknis dan pemecahan masalah melalui kurikulum terstruktur.', role: 'Peserta' },
                { year: 2022, title: 'Relawan Siaga Bencana', desc: 'Memberikan kontribusi nyata dalam kegiatan kemanusiaan dan penanggulangan bencana, menunjukkan kepedulian sosial.', role: 'Relawan' },
                { year: 2022, title: 'RTL (Rencana Tindak Lanjut)', desc: 'Berpartisipasi dalam program pengembangan diri dan perencanaan karir, mengidentifikasi tujuan dan langkah-langkah pencapaian.', role: 'Peserta' }
            ];

            function createTimeline(containerId, data) {
                const container = document.getElementById(containerId);
                const years = [...new Set(data.map(item => item.year))].sort((a, b) => b - a);

                let timelineHTML = `<div class="flex justify-center mb-8 space-x-2 md:space-x-4">`;
                years.forEach((year, index) => {
                    timelineHTML += `<button class="year-btn px-4 py-2 rounded-full text-sm font-semibold transition ${index === 0 ? 'bg-gray-800 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" data-year="${year}" data-container="${containerId}">${year}</button>`;
                });
                timelineHTML += `</div>`;

                years.forEach((year, index) => {
                    const itemsForYear = data.filter(item => item.year === year);
                    timelineHTML += `<div id="${containerId}-${year}" class="year-content ${index !== 0 ? 'hidden' : ''}">`;
                    itemsForYear.forEach(item => {
                        const isProject = 'tags' in item;
                        timelineHTML += `
                            <div class="timeline-item relative pl-10 pb-8">
                                <div class="timeline-dot w-5 h-5 bg-white border-2 border-[#C5A48A] rounded-full"></div>
                                <div class="card p-6 rounded-lg shadow-sm">
                                    <p class="text-sm font-semibold text-[#C5A48A]">${isProject ? item.tags.join(' · ') : item.role}</p>
                                    <h3 class="text-lg font-bold mt-1 text-gray-900">${item.title}</h3>
                                    <p class="mt-2 text-gray-600">${item.desc}</p>
                                    ${item.link ? `<a href="${item.link}" target="_blank" rel="noopener noreferrer" class="text-[#C5A48A] hover:underline text-sm mt-2 inline-block mr-4">Lihat Proyek</a>` : ''}
                                    ${item.certificate ? `<a href="${item.certificate}" target="_blank" rel="noopener noreferrer" class="text-[#C5A48A] hover:underline text-sm mt-2 inline-block mr-4">Lihat Sertifikat</a>` : ''}
                                    ${item.documentation ? `<a href="${item.documentation}" target="_blank" rel="noopener noreferrer" class="text-[#C5A48A] hover:underline text-sm mt-2 inline-block">Lihat Dokumentasi</a>` : ''}
                                </div>
                            </div>
                        `;
                    });
                    timelineHTML += `</div>`;
                });

                container.innerHTML = timelineHTML;
            }

            createTimeline('projects-timeline', projectsData);
            createTimeline('experience-timeline', experienceData);

            document.querySelectorAll('.year-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const year = this.dataset.year;
                    const containerId = this.dataset.container;

                    document.querySelectorAll(`#${containerId} .year-btn`).forEach(btn => {
                        btn.classList.remove('bg-gray-800', 'text-white');
                        btn.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
                    });
                    this.classList.add('bg-gray-800', 'text-white');
                    this.classList.remove('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
                    
                    document.querySelectorAll(`#${containerId} .year-content`).forEach(content => {
                        content.classList.add('hidden');
                    });

                    document.getElementById(`${containerId}-${year}`).classList.remove('hidden');
                });
            });

            const ctx = document.getElementById('skillsChart').getContext('2d');
            new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: ['Machine Learning', 'Pengembangan Web', 'Analisis Data', 'Pemrograman', 'Cloud & Tools', 'Soft Skills'],
                    datasets: [{
                        label: 'Tingkat Keahlian',
                        data: [85, 90, 80, 88, 75, 95],
                        backgroundColor: 'rgba(197, 164, 138, 0.2)',
                        borderColor: 'rgba(197, 164, 138, 1)',
                        pointBackgroundColor: 'rgba(197, 164, 138, 1)',
                        pointBorderColor: '#fff',
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: 'rgba(197, 164, 138, 1)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            angleLines: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            },
                            pointLabels: {
                                font: {
                                    size: 14,
                                },
                                color: '#4A4A4A'
                            },
                            ticks: {
                                backdropColor: 'transparent',
                                color: '#888',
                                stepSize: 25
                            },
                            suggestedMin: 0,
                            suggestedMax: 100
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.r !== null) {
                                        label += context.parsed.r + '%';
                                    }
                                    return label;
                                }
                            }
                        }
                    }
                }
            });

            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');
            mobileMenuButton.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
            document.querySelectorAll('#mobile-menu a').forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                });
            });
            
            document.getElementById('year').textContent = new Date().getFullYear();

            const sections = document.querySelectorAll('section');
            const navLinks = document.querySelectorAll('.nav-link');
            window.onscroll = () => {
                let current = '';
                sections.forEach(section => {
                    const sectionTop = section.offsetTop;
                    if (pageYOffset >= sectionTop - 68) {
                        current = section.getAttribute('id');
                    }
                });
                navLinks.forEach(link => {
                    link.classList.remove('active');
                    if (link.getAttribute('href').includes(current)) {
                        link.classList.add('active');
                    }
                });
            };
        });
    </script>
</body>
</html>
